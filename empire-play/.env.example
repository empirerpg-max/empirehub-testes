# Empire Play — variáveis de ambiente
# Copie para .env e preencha os valores

# Telegram Bot (crie via @BotFather)
VITE_TELEGRAM_BOT_TOKEN=

# ID do canal/grupo de armazenamento (-100... para grupos)
VITE_TELEGRAM_CHAT_ID=

# Google Sheets API (Google Cloud Console → APIs & Services → Credentials)
VITE_SHEETS_API_KEY=

# ID da planilha (URL: /spreadsheets/d/SPREADSHEET_ID/edit)
VITE_SHEETS_SPREADSHEET_ID=

# Apps Script Web App (Executar como: Eu | Acesso: Qualquer pessoa)
VITE_GAS_SCRIPT_URL=
