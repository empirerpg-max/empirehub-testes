# Empire Hub — Variáveis de ambiente
# Copie para .env e preencha com seus valores reais

# URL do Google Apps Script (Web App publicado)
# Obtenha em: Apps Script > Implantar > Nova implantação > App da Web
VITE_GAS_URL=https://script.google.com/macros/s/SEU_DEPLOYMENT_ID/exec

# Telegram Bot Token (obtido via @BotFather)
# https://t.me/BotFather > /newbot
VITE_TELEGRAM_BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff

# ID do chat/canal onde os arquivos serão armazenados
# Para grupos: -100xxxxxxxxxx (com -100 na frente)
# Para canais: @nome_do_canal ou ID numérico
# Como descobrir: adicione @userinfobot ao grupo e envie uma mensagem
VITE_TELEGRAM_CHAT_ID=-1001234567890
