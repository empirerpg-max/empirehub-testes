# ============================================================
# Empire Hub — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o .env — ele já está no .gitignore.
# ============================================================

# ─── Google Apps Script ───────────────────────────────────────────────────
# URL do Web App do GAS (Empire Play — Code.gs).
# DEPLOYMENT ATUAL (produção):
VITE_GAS_URL=https://script.google.com/macros/s/AKfycby7Epe3MHPMvje5OKtSlNn-tSWpowLPOJ7DVflFJqgZNOKCnN9IcGwWYL1QSeRtgJrQ7w/exec

# ─── Google Sheets API v4 (leitura pública) ─────────────────────────────
# Chave pública com Sheets API v4 habilitada (Google Cloud Console).
# Restrinja por HTTP referrer. Usada por sheetsService.ts.
VITE_SHEETS_API_KEY=AIzaSy...

# ─── Telegram proxy (opcional — apenas dev local) ──────────────────────
# EM PRODUÇÃO: deixe vazio. O upload passa pelo VITE_GAS_URL acima.
# EM DEV LOCAL: aponte para o servidor proxy Node rodando localmente.
VITE_TELEGRAM_API_BASE=
# Exemplo dev: VITE_TELEGRAM_API_BASE=http://localhost:3001

# ============================================================
# VARIÁVEIS QUE NUNCA VÊM PARA O FRONTEND (VITE_)
# Ficam SOMENTE no GAS via PropertiesService.getScriptProperties():
#   TG_BOT_TOKEN    ← token do bot (@BotFather)
#   TG_CHANNEL_ID   ← ID do canal de storage (-100xxxxxxxxxx)
#   CHARTS_SHEET_ID ← ID da planilha de Charts
# ============================================================
