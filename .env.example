# ─── Front (Vite) ─────────────────────────────────────────────────────────────
# Base URL da API intermediária. Em dev aponta para localhost.
# Em produção troque pela URL pública (ex: https://api.seudominio.com)
VITE_TELEGRAM_API_BASE=http://localhost:3001

# ─── API intermediária (api/server.js) ────────────────────────────────────────

# Token do bot Telegram (obtenha via @BotFather)
BOT_TOKEN=123456:ABC-DEFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID do canal/grupo usado como storage de mídia.
# Use um canal privado. O bot deve ser admin com permissão de envio.
# Formato: -100XXXXXXXXXX  (canais) ou @username (públicos, não recomendado)
CHAT_ID=-1001234567890

# Porta da API intermediária
PORT=3001

# ─── Opcional: Local Bot API Server (para arquivos > 20 MB) ───────────────────
# Se estiver rodando o Telegram Bot API Server localmente com --local,
# descomente e aponte para o servidor local.
# TELEGRAM_API_ROOT=http://localhost:8081/bot
